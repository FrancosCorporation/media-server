# Copie para .env fora do Git e preencha os segredos antes de iniciar.
# Na primeira inicialização, a senha do admin precisa ter pelo menos 16 bytes.
NODE_ENV=production
API_PORT=4000
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Origens exatas do frontend; separe várias por vírgula.
FRONTEND_URLS=http://localhost:5173
FRONTEND_URL=

# Serviços de mídia e busca
RADARR_URL=http://radarr:7878
RADARR_API_KEY=
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=
JACKETT_URL=http://jackett:9117
JACKETT_API_KEY=
QBITTORRENT_URL=http://qbittorrent:8082
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
JELLYFIN_URL=http://jellyfin:8096
JELLYFIN_API_KEY=
SSDP_HELPER_URL=http://ssdp-helper:9090
FLARESOLVERR_URL=http://flaresolverr:8191/v1
CHROMIUM_PATH=/usr/bin/chromium

# Metadados e OAuth (opcionais conforme os recursos usados)
TMDB_API_KEY=
OMDB_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Cache de imagens; os limites são validados pelo backend.
TMDB_IMAGE_CACHE_DIR=/app/cache/tmdb-images
TMDB_IMAGE_CACHE_MAX_BYTES=5368709120
TMDB_IMAGE_CACHE_MIN_FREE_BYTES=536870912
TMDB_IMAGE_CACHE_TTL_MS=7776000000

# Preferências e conversão
DEFAULT_QUALITY=1080p
PREFER_HEVC=true
PREFER_LANGUAGE=pt
FALLBACK_LANGUAGE=en
CONVERSION_MAX_RETRIES=2
CONVERSION_CONCURRENCY=1
TRANSCODE_PRESET=veryfast
TRANSCODE_CRF=25
TRANSCODE_THREADS=4
POSTPROCESS_MODE=noturno
POSTPROCESS_PRESET=veryfast
POSTPROCESS_X264_PRESET=slow
POSTPROCESS_CRF=25
POSTPROCESS_CONCURRENCY=1
POSTPROCESS_THREADS=8
POSTPROCESS_AUDIO_BITRATE=128k
POSTPROCESS_HWACCEL=vaapi
POSTPROCESS_VIDEO_BITRATE=1200k
POSTPROCESS_MAX_BITRATE=1500k
POSTPROCESS_BUFSIZE=3000k
POSTPROCESS_PROBE_POINTS=5
POSTPROCESS_PROBE_SAMPLE=30
POSTPROCESS_MIN_BITRATE=600
POSTPROCESS_MAX_TARGET_BITRATE=6000
POSTPROCESS_ADAPTIVE=true
TORRENT_BYPASS_ENABLED=false
